# 变量必须以 VITE_ 为前缀才能暴露给外部读取
NODE_ENV = 'development'
# 是否去除console 和 debugger
VITE_DELETE_CONSOLE = false
# 是否开启sourcemap
VITE_SHOW_SOURCEMAP = false

# development mode 后台请求地址
# VITE_SERVER_BASEURL = 'https://dev.xxx.com'

# 本地联调：后端 Nuxt（Better Auth）地址，非 H5 端（小程序/App）直连时使用
VITE_SERVER_BASEURL = 'http://localhost:9999'
# H5 端开启 vite 代理：同源 /api -> http://localhost:9999（保留 /api 前缀，Cookie 单通道）
VITE_APP_PROXY_ENABLE = true
VITE_APP_PROXY_PREFIX = '/api'

# 微信「获取手机号」登录联调开关：true 时走后端 mock（普通按钮 + 手输手机号），无需认证小程序
VITE_WECHAT_MOCK = true

# 腾讯位置服务 key（H5 端 uni.chooseLocation 必需；留空时 H5 无法调起选点页，可手动填写地址降级）
VITE_QQMAP_KEY = ''
# 签到二维码指向的 H5 基址；留空时开发态回退当前站点 origin
VITE_H5_BASE_URL = ''
