# 数据库（本地 PostgreSQL 容器，不新建容器）
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/zhongailianmeng

# Better Auth
BETTER_AUTH_URL=http://localhost:9999
# 至少 32 字符的随机字符串，可用：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-chars
# 允许携带凭证跨域访问后端的前端来源（逗号分隔）
TRUSTED_ORIGINS=http://localhost:9999,http://localhost:3333,https://servicewechat.com

# 初始管理员（db:seed 使用，密码至少 8 位）
ADMIN_EMAIL=admin@zhongailianmeng.local
ADMIN_PASSWORD=ChangeMe123

# 速率限制（每 IP 每窗口最大请求数，窗口固定 60s）
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_SENSITIVE_MAX=10
# 关注/取关写操作（默认 30）
RATE_LIMIT_FOLLOW_MAX=30
# 公开埋点上报（游客可报，配额严于全局，防止匿名刷库）
RATE_LIMIT_ANALYTICS_MAX=30

# 微信小程序「获取手机号」登录
# 真实模式：填写已认证小程序的 AppID/AppSecret（生产务必通过环境注入，勿提交真实密钥）
WECHAT_APPID=
WECHAT_SECRET=
# 开发联调开关：true 时不调用微信 API，phoneCode 传 'mock:13800138000' 即可模拟；生产必须为 false 或不设置
WECHAT_MOCK=false

# 微信公众号（H5 微信内 JS-SDK 自定义分享卡片；注意与上方小程序凭证不是同一个 AppID）
# 需已认证的服务号/订阅号，并在公众号后台配置「JS 接口安全域名」；留空时分享自动降级为引导+复制链接
WECHAT_OA_APPID=
WECHAT_OA_SECRET=

# 阿里云短信（验证码真实发送）
# 以下四项全部配置后验证码经阿里云 SendSms 发送；缺任一项自动回退为后端日志打印（仅限开发）
# 建议使用仅授予 AliyunDysmsFullAccess 的 RAM 子账号密钥；生产通过环境注入，勿提交真实密钥
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
# 审核通过的短信签名名称（短信服务控制台 → 国内消息 → 签名管理）
ALIYUN_SMS_SIGN_NAME=
# 验证码模板 CODE（模板变量必须命名为 code，如「您的验证码为${code}」）
ALIYUN_SMS_TEMPLATE_CODE=

# 腾讯云 COS（前端直传 + 媒体管理）
# 永久密钥仅服务端使用，生产通过环境注入，勿提交真实密钥
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
# 存储桶名（形如 name-1250000000）与地域
TENCENT_COS_BUCKET=
TENCENT_COS_REGION=ap-shanghai
# CDN/自定义访问域名（不含结尾斜杠）；留空使用 COS 默认域名
TENCENT_COS_DOMAIN=
# 临时凭证有效期（秒）
TENCENT_COS_STS_TTL=1800

# 腾讯云 OCR（实名认证证件识别，复用上方 COS 永久密钥）
# OCR 服务地域（默认可不填，默认 ap-guangzhou）
TENCENT_OCR_REGION=ap-guangzhou
# 开发开关：true 时返回固定识别结果，不调用腾讯云
OCR_MOCK=false

# 缓存机制
# CACHE_DRIVER=memory：进程内缓存（默认，单实例部署；重启失效）
# CACHE_DRIVER=redis：共享缓存，多实例部署使用，必须提供 CACHE_REDIS_URL
CACHE_DRIVER=memory
# Redis 连接串（仅 CACHE_DRIVER=redis 时需要），如 redis://127.0.0.1:6379
CACHE_REDIS_URL=
# 默认缓存过期时间（秒，兜底用；settings 写入会主动失效）
CACHE_TTL=300
# Redis key 前缀（同一 Redis 上多个应用时隔离）
CACHE_KEY_PREFIX=app
